[Unit]
Description=OptionsCommander - daily routine scheduler (paper account)
Documentation=https://github.com/iAmGiG/OptionsCommander
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
# Edit the project path (here and below) and the python path for your install
WorkingDirectory=/home/trader/OptionsCommander
Environment="PYTHONPATH=/home/trader/OptionsCommander"

# The same entry point as the CLI scheduler's "start", so the CLI sees it as running.
# Routine times are in ET whatever the host timezone, on NYSE trading days only, and a
# lock in state/ keeps it from overlapping with a cron or manual run.
ExecStart=/home/trader/miniconda3/envs/OptionsCommander/bin/python -s -u main.py --daemon

# Restart policy
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=600

# Logging: the daemon writes state/scheduler.log itself (rotated); stderr keeps crashes
StandardOutput=null
StandardError=append:/home/trader/OptionsCommander/state/scheduler-daemon.err
SyslogIdentifier=optionscommander-scheduler

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/OptionsCommander/state /home/trader/OptionsCommander/reports /home/trader/OptionsCommander/logs /home/trader/OptionsCommander/.cache

# Resource limits
CPUQuota=50%
MemoryMax=1G

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
